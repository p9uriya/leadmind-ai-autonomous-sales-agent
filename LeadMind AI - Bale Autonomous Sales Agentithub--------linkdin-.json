      "parameters": {
        "jsCode": "let scored = [];\ntry { scored = $('Hybrid Lead Scoring').all(); } catch (e) { scored = []; }\nconst total = scored.length;\nconst hot = scored.filter(i => (i.json.category || '') === 'HOT').length;\nconst emailed = scored.filter(i => i.json.primary_email && (i.json.lead_score || 0) >= 80).length;\nlet chat_id = '';\ntry { chat_id = $('Extract ICP').first().json.chat_id; } catch (e) { chat_id = ''; }\nconst reply = '🎯 تحقیق سرنخ کامل شد!\\n\\n🏢 ' + total + ' شرکت بررسی شد\\n🔥 ' + hot + ' سرنخ داغ (HOT) شناسایی شد\\n📧 ' + emailed + ' ایمیل معرفی ارسال شد\\n\\nبرای شروع گفتگو کافیه پیام بدید 💬';\nreturn [{ json: { chat_id, reply, total, hot, emailed } }];"
      },
