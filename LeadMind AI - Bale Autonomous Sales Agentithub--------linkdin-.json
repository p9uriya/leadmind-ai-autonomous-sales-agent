      "parameters": {
        "jsCode": "const slots = ['10:00','14:00','16:30'];\nconst rawText = ($json.text || '').trim();\n// strip leading emoji/symbols so menu buttons match regardless of icon\nconst text = rawText.replace(/^[^\\p{L}\\p{N}\\/]+/u, '').trim();\nlet route = 'chat';\nlet selected_slot = '';\nlet menu_action = '';\nconst m = rawText.match(/(\\d{1,2}:\\d{2})/);\nconst hit = slots.includes(rawText) ? rawText : (m && slots.includes(m[1]) ? m[1] : '');\nif (text.startsWith('/lead') || /پیدا کردن مشتری|جستجوی شرکت|یافتن سرنخ/.test(text)) {\n  route = 'lead';\n} else if (hit) {\n  route = 'slot'; selected_slot = hit;\n} else if (/رزرو جلسه|تنظیم جلسه|قرار ملاقات|رزرو دمو|دموی محصول/.test(text)) {\n  route = 'book';\n} else if (/^\\/start$|^\\/menu$|^منو$|^شروع$|راهنما|منوی اصلی/.test(text)) {\n  route = 'menu';\n}\nreturn [{json:{...$json, text: rawText, clean_text: text, route, selected_slot, menu_action}}];"
      },
