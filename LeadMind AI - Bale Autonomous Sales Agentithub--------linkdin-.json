        "jsCode": "const cal = $json || {};\nlet link = cal.hangoutLink || '';\nif (!link && cal.conferenceData && cal.conferenceData.entryPoints && cal.conferenceData.entryPoints[0]) { link = cal.conferenceData.entryPoints[0].uri || ''; }\nconst cm = $('Confirm Meeting').item.json;\nlet reply = '✅ عالیه! جلسه شما با موفقیت ثبت شد.\\n\\n📅 روز: ' + cm.day_label + '\\n⏰ ساعت: ' + cm.selected_slot;\nif (link) { reply += '\\n\\n🔗 لینک Google Meet:\\n' + link; }\nreply += '\\n\\nمنتظر دیدنتون هستیم! 🌟';\nreturn [{ json: { ...cm, reply, meet_link: link, reply_markup: { remove_keyboard: true } } }];"
