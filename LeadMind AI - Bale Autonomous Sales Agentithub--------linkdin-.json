    {
      "parameters": {
        "jsCode": "const slot = ($json.selected_slot || '10:00');\nconst [hh, mm] = slot.split(':').map(Number);\nconst now = new Date();\nconst tehran = new Date(now.getTime() + (210*60000) + now.getTimezoneOffset()*60000);\nlet dayLabel = 'امروز';\nif ((hh*60+mm) <= (tehran.getHours()*60 + tehran.getMinutes())) { tehran.setDate(tehran.getDate()+1); dayLabel = 'فردا'; }\nconst y = tehran.getFullYear();\nconst mo = String(tehran.getMonth()+1).padStart(2,'0');\nconst d = String(tehran.getDate()).padStart(2,'0');\nconst start = y+'-'+mo+'-'+d+'T'+String(hh).padStart(2,'0')+':'+String(mm).padStart(2,'0')+':00+03:30';\nconst end = y+'-'+mo+'-'+d+'T'+String((hh+1)%24).padStart(2,'0')+':'+String(mm).padStart(2,'0')+':00+03:30';\nreturn [{json:{...$json, meeting_start:start, meeting_end:end, day_label:dayLabel, selected_slot:slot}}];"
      },
