    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst out = [];\nfor (const it of items) {\n  const j = it.json || {};\n  const results = (j.web && j.web.results) || j.organic_results || j.results || (Array.isArray(j) ? j : [j]);\n  for (const r of results) {\n    const u = r.url || r.link || r.website;\n    if (!u || seen.has(u)) continue;\n    seen.add(u);\n    out.push({ json: { ...r, url: u } });\n  }\n}\nreturn out;"
      },
