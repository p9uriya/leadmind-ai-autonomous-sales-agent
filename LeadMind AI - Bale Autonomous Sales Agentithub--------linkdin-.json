      "parameters": {
        "jsCode": "const intel = $json;\nconst base = $('Extract Emails').item.json;\nconst s = String(intel.output || '');\nlet score = 50;\nif (/saas|software/i.test(s)) score += 15;\nif (/b2b/i.test(s)) score += 10;\nif (/pain|need|challenge/i.test(s)) score += 15;\nif (base.primary_email) score += 5;\nscore = Math.min(score, 100);\nreturn [{ json: { url: base.url, emails: base.emails, primary_email: base.primary_email, analysis: intel.output, output: intel.output, lead_score: score, category: score >= 80 ? 'HOT' : score >= 60 ? 'WARM' : 'COLD' } }];"
